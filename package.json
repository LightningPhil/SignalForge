{
  "name": "signal-forge",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mathjs": "^12.4.3",
    "papaparse": "^5.4.1",
    "plotly.js-dist-min": "^2.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/papaparse": "^5.3.16",
    "@types/plotly.js": "^2.35.8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
