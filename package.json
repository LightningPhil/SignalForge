{
  "name": "signal-forge",
  "private": true,
  "version": "6.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:dist:artifact": "node scripts/verify-dist.mjs --artifact-only",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:lab": "vitest run tests/lab tests/bench/scale-100k.test.ts tests/bench/cancellation-budget.test.ts",
    "test:bench:1m": "node scripts/run-1m-bench.mjs",
    "lab:checksums": "node --experimental-strip-types scripts/update-lab-checksums.mjs --check",
    "lab:update-checksums": "node --experimental-strip-types scripts/update-lab-checksums.mjs --write",
    "bench:report": "node --experimental-strip-types scripts/bench-report.mjs",
    "bench:performance": "tsx scripts/run-performance-bench.mjs",
    "smoke:pages": "node scripts/smoke-pages.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mathjs": "^12.4.3",
    "papaparse": "^5.4.1",
    "plotly.js-dist-min": "^2.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/papaparse": "^5.3.16",
    "@types/plotly.js": "^2.35.8",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
